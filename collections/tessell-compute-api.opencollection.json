{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tessell APIs activity-center Compute API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Compute",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of Compute Profiles.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{server}/compute-service/computes",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "include-availability",
                "value": "",
                "type": "query",
                "description": "Whether to include availability info"
              },
              {
                "name": "subscription-name",
                "value": "default",
                "type": "query",
                "description": "Subscription Name"
              },
              {
                "name": "region",
                "value": "",
                "type": "query",
                "description": "Cloud Region"
              },
              {
                "name": "cloud-type",
                "value": "[object Object]",
                "type": "query",
                "description": "Cloud type of the compute"
              },
              {
                "name": "use-cases",
                "value": "",
                "type": "query",
                "description": "Use Case of the compute"
              },
              {
                "name": "include-internal",
                "value": "",
                "type": "query",
                "description": "Includes Internal Computes"
              },
              {
                "name": "all-computes",
                "value": "",
                "type": "query",
                "description": "Returns All Computes"
              },
              {
                "name": "page-size",
                "value": "",
                "type": "query",
                "description": "Page size for get query"
              },
              {
                "name": "page-offset",
                "value": "",
                "type": "query",
                "description": "Page offset for get query"
              }
            ]
          },
          "docs": "Get a list of Compute Profiles"
        },
        {
          "info": {
            "name": "Get all available vcpus, even if some are disabled for an user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{server}/compute-service/all-available-vcpus",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page-size",
                "value": "",
                "type": "query",
                "description": "Page size for get query"
              },
              {
                "name": "page-offset",
                "value": "",
                "type": "query",
                "description": "Page offset for get query"
              },
              {
                "name": "time-zone",
                "value": "",
                "type": "query",
                "description": "Timezone for return data"
              },
              {
                "name": "cloud-type",
                "value": "[object Object]",
                "type": "query",
                "description": "Cloud type of the compute"
              }
            ]
          },
          "docs": "Get all available vcpus, even if some are disabled for an user"
        }
      ]
    }
  ],
  "bundled": true
}