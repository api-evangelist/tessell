      "info": {
        "name": "rpo-policy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of RPO policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{server}/availability-machines/rpo-policies",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "pitr-enabled",
                "value": "",
                "type": "query",
                "description": "If true, it will return all of the RPO policies where PITR is non-zero. \nIf false, it will return all RPO policies where PITR is zero. \nIf not specified, it will return all of the RPO policies irrespective of PITR retention.\n"
              },
              {
                "name": "page-size",
                "value": "",
                "type": "query",
                "description": "Page size for get query"
              },
              {
                "name": "page-offset",
                "value": "",
                "type": "query",
                "description": "Page offset for get query"
              },
              {
                "name": "time-zone",
                "value": "",
                "type": "query",
                "description": "Timezone for return data"
              }
            ]
          },
          "docs": "Get a list of RPO policies"
