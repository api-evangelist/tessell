            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start-time",
                "value": "",
                "type": "query",
                "description": "Start timestamp, when searching events in a range"
              },
              {
                "name": "end-time",
                "value": "",
                "type": "query",
                "description": "End timestamp, when searching events in a range"
              }
            ]
          },
