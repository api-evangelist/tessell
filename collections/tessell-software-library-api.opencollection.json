{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tessell APIs activity-center Software Library API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Software Library",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all software images. Using the name filter, a software image can be found using name.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{server}/software-library/images",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cloudType",
                "value": "",
                "type": "query",
                "description": "Name of the Cloud"
              },
              {
                "name": "region",
                "value": "",
                "type": "query",
                "description": "Cloud Region"
              },
              {
                "name": "personas",
                "value": "[object Object]",
                "type": "query",
                "description": "Personas list"
              },
              {
                "name": "name",
                "value": "[object Object]",
                "type": "query",
                "description": "Name of a Software Image"
              },
              {
                "name": "allImages",
                "value": "",
                "type": "query",
                "description": "Returns All Software Images"
              },
              {
                "name": "timeZone",
                "value": "",
                "type": "query",
                "description": "Time Zone"
              },
              {
                "name": "softwareImageProviderType",
                "value": "",
                "type": "query",
                "description": "softwareImageProviderType"
              }
            ]
          },
          "docs": "Get a list of all software images."
        },
        {
          "info": {
            "name": "Get Software Image by name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{server}/software-library/image/:name",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Software Image name"
              },
              {
                "name": "versionName",
                "value": "",
                "type": "query",
                "description": "Software Image version name"
              },
              {
                "name": "softwareImageProviderType",
                "value": "",
                "type": "query",
                "description": "softwareImageProviderType"
              },
              {
                "name": "cloudType",
                "value": "",
                "type": "query",
                "description": "Name of the Cloud"
              },
              {
                "name": "timeZone",
                "value": "",
                "type": "query",
                "description": "Time Zone"
              }
            ]
          },
          "docs": "Get Software Image by name"
        }
      ]
    }
  ],
  "bundled": true
}