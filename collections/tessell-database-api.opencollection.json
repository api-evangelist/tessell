                "value": "",
                "type": "path",
                "description": "The ID of the DB Service"
              },
              {
                "name": "database-id",
                "value": "",
                "type": "path",
                "description": "The ID of the database in the DB Service"
              }
            ]
          },
          "docs": "Checks if the specified database (e.g., Oracle PDB) has any associated backups.\nThis can be used to validate whether a database can be deleted or if it has\nbackups that need to be handled first.\n"
        },
